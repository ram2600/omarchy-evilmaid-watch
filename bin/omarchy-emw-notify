#!/bin/bash

# omarchy:summary=Deliver a emw notification into the desktop session from root
# omarchy:args=<headline> [description] [--image <path>] [--urgency <low|normal|critical>]
# omarchy:examples=omarchy-emw-notify "Lid opened" "While locked" --urgency critical
# omarchy:hidden=true
# omarchy:requires-sudo=true

# Root -> user session bridge.
#
# omarchy-notification-send talks to the notification daemon over the *session*
# bus (`busctl --user`). A system service runs with no session bus at all, so
# calling it directly from the emw daemon fails silently. Nothing in Omarchy
# bridges that gap today, so this does: resolve the desktop session, then drop
# to that user with the right bus address in the environment.
#
# Delivery is best effort. The incident is already on disk and the remote alert
# is already queued by the time we get here, so a missing toast must never fail
# the caller - exit 0 on every "no session" path.

set -euo pipefail

readonly CONFIG_FILE=/etc/omarchy/emw.conf

# nf-md-shield_lock, escaped so this file reads without a Nerd Font installed.
readonly EMW_GLYPH=$'\U000f099d'

urgency=critical
image=""
positional=()

while (($# > 0)); do
  case $1 in
  --image)
    image=${2:-}
    shift 2
    ;;
  --urgency)
    urgency=${2:-critical}
    shift 2
    ;;
  *)
    positional+=("$1")
    shift
    ;;
  esac
done

if ((${#positional[@]} == 0)); then
  echo "usage: omarchy-emw-notify <headline> [description] [--image <path>] [--urgency <u>]" >&2
  exit 64
fi

headline=${positional[0]}
description=${positional[1]:-}

# --- Resolve the desktop user ---------------------------------------------
EMW_USER=""
if [[ -r $CONFIG_FILE ]]; then
  # Read only the one key we need rather than sourcing the whole config: this
  # runs as root, and sourcing is arbitrary code execution if the file is ever
  # writable by anyone else.
  EMW_USER=$(sed -n 's/^[[:space:]]*EMW_USER=\([^#]*\).*/\1/p' "$CONFIG_FILE" | tr -d '"'\''[:space:]' | head -1)
fi

# --- Find that user's graphical session ------------------------------------
# A user can have several sessions (here: one seat0 tty session and one
# "manager" session). Only a seated, user-class session has a notification
# daemon behind it, so match on Class and Seat rather than taking the first row.
session_uid=""
while read -r sid _rest; do
  [[ -n $sid ]] || continue
  props=$(loginctl show-session "$sid" -p Name -p Class -p Seat -p State 2>/dev/null || true)
  [[ $props == *"Class=user"* ]] || continue
  [[ $props == *"Seat=seat"* ]] || continue
  name=${props#*Name=}
  name=${name%%$'\n'*}
  if [[ -z $EMW_USER || $name == "$EMW_USER" ]]; then
    EMW_USER=$name
    session_uid=$(id -u "$name" 2>/dev/null || true)
    break
  fi
done < <(loginctl list-sessions --no-legend 2>/dev/null || true)

if [[ -z $EMW_USER || -z $session_uid ]]; then
  echo "emw-notify: no graphical session; skipping toast" >&2
  exit 0
fi

readonly BUS_PATH="/run/user/$session_uid/bus"
if [[ ! -S $BUS_PATH ]]; then
  echo "emw-notify: no session bus at $BUS_PATH; skipping toast" >&2
  exit 0
fi

# --- Deliver ---------------------------------------------------------------
# Keeping the DEFAULT app name (omarchy-action) is deliberate: per
# docs/notifications.md only two senders punch through the user's own
# do-not-disturb, and omarchy-action is one of them. A tamper alert that the
# user's do-not-disturb swallows is worse than no alert, because they would
# trust it.
# omarchy-crash-watch relies on exactly this for the same reason.
notify_args=(--urgency "$urgency" --glyph "$EMW_GLYPH")

# The notification server runs as the desktop user and reads the image path
# itself. Evidence lives in a 0700 root directory, so passing that path
# directly yields a toast with a silently missing thumbnail. Stage a copy the
# user can read.
#
# NOT in the user's own /run/user/$uid: logind mounts that tmpfs after these
# units start, and it lands READ-ONLY inside their mount namespace even with
# ReadWritePaths=/run/user - that covers the parent directory, not the later
# submount. Writes there failed silently while the toast still delivered,
# because connect()ing to the bus socket is not a filesystem write. Verified
# with `systemd-run` replicating the unit sandbox: ro,nosuid,nodev...uid=1001.
#
# RuntimeDirectory= is the supported way to get a writable tmpfs directory
# inside the namespace: /run/omarchy-emw, mode 0711 so the daemon can open a
# known path without the directory being listable, and gone at reboot.
#
# The path must be a file:// URI. A bare absolute path is accepted by
# omarchy-notification-send, sent as the image-path hint, and then silently
# dropped: the notification server stores image="" and the toast shows the
# glyph instead. Every EMW toast ever sent did this - the staging fix made the
# file readable but the image still never arrived, and "toast delivered" looked
# like success. Measured four ways against the persisted notification JSON:
#
#   --image /path          -> image=""                       (dropped)
#   --image file:///path   -> image="file:///...images/...-image"  (works)
#   -i /path, -i file://   -> appIcon=... (works, but appIcon is the sender icon)
#
# Staging stays on tmpfs deliberately. The notification server copies any
# file-backed image into ~/.local/state/omarchy/notifications/images/ when it
# persists the entry, and rewrites the entry to point at that copy - so the
# durable copy is Omarchy's, ours only has to outlive the busctl call, and a
# toast restored after a reboot keeps its photo. Staging under EVIDENCE_DIR
# instead would leave a permanently user-readable duplicate of every incident
# photo on a directory whose whole point is that only root can read them.
stage_dir=${RUNTIME_DIRECTORY:-/run/omarchy-emw}
stage_dir=${stage_dir%%:*}
image_arg=none
if [[ -n $image && -f $image ]]; then
  mkdir -p "$stage_dir" 2>/dev/null && chmod 0711 "$stage_dir" 2>/dev/null || true
  staged="$stage_dir/toast-$(basename "$(dirname "$image")").jpg"
  # Report why it failed. A silently thumbnail-less toast looks like a working
  # alert, so a swallowed errno here costs more than the noise of logging it.
  if stage_err=$(install -m 0600 -o "$EMW_USER" "$image" "$staged" 2>&1); then
    image_arg="file://$staged"
    notify_args+=(--image "$image_arg")
    # The daemon reads the file after we exit, so it cannot be removed here.
    # Sweep older copies instead; the directory is tmpfs and dies at reboot.
    find "$stage_dir" -maxdepth 1 -name 'toast-*.jpg' -mmin +60 -delete 2>/dev/null || true
  else
    image_arg="failed to stage"
    echo "emw-notify: could not stage $image for the notification server: ${stage_err:-unknown error}" >&2
  fi
fi

# Headline and description stay positional. They can contain attacker-derived
# text (a USB device's product string), and omarchy-notification-send passes
# positionals to busctl as typed parameters, so they can never be reparsed as
# options or as a shell command.
# Not exec'd: we want to report whether the toast actually landed. An alert
# that silently fails to appear is the worst outcome for this tool, because it
# looks identical to "nothing happened".
if runuser -u "$EMW_USER" -- env \
  XDG_RUNTIME_DIR="/run/user/$session_uid" \
  DBUS_SESSION_BUS_ADDRESS="unix:path=$BUS_PATH" \
  /usr/bin/omarchy-notification-send \
  "${notify_args[@]}" \
  "$headline" "$description"; then
  # Names the image argument actually passed, so "delivered" can never again
  # mean "delivered without the photograph" without saying so.
  echo "emw-notify: toast delivered to $EMW_USER (image: $image_arg)" >&2
else
  status=$?
  echo "emw-notify: omarchy-notification-send failed (exit $status)" >&2
  exit "$status"
fi
