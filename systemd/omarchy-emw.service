[Unit]
Description=Omarchy EvilMaid Watch - physical-access (evil-maid) detection
Documentation=https://github.com/objective-see/DoNotDisturb
# No ordering against udev is needed: the watcher discovers the lid device by
# capability and rescans with backoff if it is not there yet, so starting early
# costs at most one rescan rather than losing the device entirely.
After=local-fs.target systemd-logind.service

# Deliberately NOT gated with ConditionPathExists on the user's toggle file.
# Two reasons: %h expands to root's home for a system service, not the desktop
# user's, so the gate would test a path that never exists; and Condition* is
# evaluated only at unit start, so arming would need a restart to take effect.
# omarchy-emw-trigger checks the toggle per event instead.

[Service]
Type=simple
ExecStart=/usr/local/bin/omarchy-emw-watch
Restart=always
RestartSec=3

# Root is required and cannot be dropped: /dev/input/event0 is root:input 0640
# and the desktop user is in neither `input` nor `video`. Adding them to those
# groups to run unprivileged would widen the attack surface more than the
# sandbox below narrows it. So: stay root, fence root in.
ProtectSystem=strict
ReadWritePaths=/var/lib/omarchy-emw
# /run/user must be writable, which is not obvious and cost a silently missing
# alert to find. ProtectSystem=strict makes the whole hierarchy read-only bar
# /dev, /proc and /sys, so without this the watcher cannot stage the photo
# where the notification server can read it, AND cannot connect() to the
# session bus socket - connecting to a unix socket needs write access to it.
# The result was an intruder verdict that alerted nobody.
ReadWritePaths=/run/user
# The trigger reads the user's toggle flag out of their home and never writes.
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes

# StateDirectory enforces 0700 root:root on every start, so a loosened
# evidence directory is repaired rather than silently tolerated.
StateDirectory=omarchy-emw
StateDirectoryMode=0700

# The trigger forks the capture, the notification bridge and the hooks; keep
# them in the cgroup so a hung child is still reaped on stop.
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
