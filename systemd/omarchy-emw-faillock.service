[Unit]
Description=Omarchy EvilMaid Watch failed-unlock watcher
After=systemd-journald.service omarchy-emw.service
Wants=systemd-journald.service

[Service]
Type=simple
ExecStart=/usr/local/bin/omarchy-emw-faillock
Restart=always
RestartSec=5

# Follows the journal and shells out to the trigger; needs the same write
# access as the main watcher for the evidence store and the session bus.
ProtectSystem=strict
ReadWritePaths=/var/lib/omarchy-emw
# See omarchy-emw.service: /run/user/$uid is read-only in here, so the toast
# photo is staged in this unit's own runtime directory instead.
RuntimeDirectory=omarchy-emw
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
