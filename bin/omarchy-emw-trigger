#!/bin/bash

# omarchy:summary=Handle a physical-access incident: capture evidence, classify it, alert
# omarchy:args=<lid|resume|faillock|usb|manual>
# omarchy:examples=omarchy-emw-trigger lid
# omarchy:hidden=true
# omarchy:requires-sudo=true

# Runs as root, invoked by the lid watcher, the resume unit, the faillock
# watcher and the USB udev rule. Every path into this script is a machine
# trigger, never a user shell, so it takes exactly one positional argument and
# never evaluates anything it is handed.

set -euo pipefail

readonly LIB_DIR=${OMARCHY_EMW_LIB:-/usr/local/lib/omarchy-emw}
# shellcheck source=../lib/emw-common.sh
source "$LIB_DIR/emw-common.sh"

source_name=${1:-manual}

# Reject anything that is not a known source. udev and systemd hand us data we
# did not generate, so this is validated rather than trusted.
case $source_name in
lid | resume | faillock | usb | manual) ;;
*)
  echo "unknown trigger source: $source_name" >&2
  exit 64
  ;;
esac

log_journal() { echo "emw[$source_name]: $*" >&2; }

# --- Enabled? --------------------------------------------------------------
if ! conf_bool ENABLED true; then
  log_journal "disabled in config, ignoring"
  exit 0
fi

triggers=$(conf_get TRIGGERS "lid,resume,faillock,usb")
if [[ ,$triggers, != *,$source_name,* && $source_name != "manual" ]]; then
  log_journal "trigger not enabled in TRIGGERS, ignoring"
  exit 0
fi

# --- Armed? ----------------------------------------------------------------
# The toggle lives in the desktop user's Omarchy state dir so `omarchy-emw
# disarm` needs no root. We deliberately do NOT gate the systemd unit on this
# file: a system service expands %h to root's home, not the user's, and
# checking here means arming takes effect instantly with no restart.
user_home=$(emw_user_home || true)
if [[ -n $user_home && -f "$user_home/.local/state/omarchy/toggles/emw-off" ]]; then
  log_journal "disarmed by user toggle, ignoring"
  exit 0
fi

# --- Debounce --------------------------------------------------------------
# Opening the lid after a suspend fires both the lid watcher and the resume
# unit within milliseconds. Without this they would become two incidents.
evidence_dir=$(conf_get EVIDENCE_DIR /var/lib/omarchy-emw)
debounce=$(conf_get DEBOUNCE_SECONDS 20)
[[ $debounce =~ ^[0-9]+$ ]] || debounce=20

mkdir -p "$evidence_dir"
chmod 700 "$evidence_dir"

readonly STATE_FILE="$evidence_dir/.last-incident"
now=$(date +%s)
last=0
last_dir=""

if [[ -r $STATE_FILE ]]; then
  read -r last last_dir <"$STATE_FILE" || true
  [[ $last =~ ^[0-9]+$ ]] || last=0
fi

if ((now - last < debounce)) && [[ -d ${last_dir:-/nonexistent} ]]; then
  # Record that a second source corroborated the open incident, then stop.
  echo "$source_name" >>"$last_dir/sources"
  log_journal "coalesced into $(basename "$last_dir") ($((now - last))s after first source)"
  exit 0
fi

# --- New incident ----------------------------------------------------------
stamp=$(date -u +%Y%m%dT%H%M%SZ)
incident_dir="$evidence_dir/incidents/$stamp-$$"
mkdir -p "$incident_dir"
chmod 700 "$incident_dir"

printf '%s\n' "$source_name" >"$incident_dir/sources"
printf '%s %s\n' "$now" "$incident_dir" >"$STATE_FILE"

log_journal "new incident $stamp-$$"

# Lock state is read NOW, before the camera warms up. Capture takes a couple of
# seconds, and if the legitimate user is already typing their password the hint
# could flip to "no" mid-capture - which would make an intruder incident look
# attended. The verdict must be based on the state at the moment of the
# trigger, not at the moment we got round to asking.
session_id=$(emw_session_id || true)
if [[ -n $session_id ]]; then
  locked_at_trigger=$(emw_locked "$session_id")
else
  locked_at_trigger=no-session
fi
printf '%s\n' "$locked_at_trigger" >"$incident_dir/locked-at-trigger"
log_journal "locked at trigger: $locked_at_trigger"

# Keep the locker's own view of the world alongside our conclusion. When a
# verdict later looks wrong, this is the difference between diagnosing it and
# guessing - it records what the lock screen actually thought at the time.
emw_user=$(conf_get EMW_USER "")
emw_uid=""
[[ -n $emw_user ]] && emw_uid=$(id -u "$emw_user" 2>/dev/null || true)
if [[ -n $emw_uid ]]; then
  emw_shell_as_user "$emw_user" "$emw_uid" lock status \
    >"$incident_dir/lock-status.json" 2>/dev/null || true
fi

# --- Append to the tamper-evident log --------------------------------------
# events.log is chattr +a where the filesystem supports it, so this append
# succeeds but a rewrite does not. Root can clear that attribute, so this is
# tamper-evidence against a non-root attacker, not tamper-proofing.
#
# This is written BEFORE any slow work. An attacker who cuts power during the
# capture still leaves this line behind.
readonly EVENTS_LOG="$evidence_dir/events.log"

jq -n -c \
  --arg ts "$(date -Is)" \
  --arg source "$source_name" \
  --arg incident "$(basename "$incident_dir")" \
  --arg host "$(hostname)" \
  '{ts: $ts, source: $source, incident: $incident, host: $host, verdict: "pending"}' \
  >>"$EVENTS_LOG"

# --- Capture evidence ------------------------------------------------------
# Deliberately BEFORE the grace period. Whoever opened the lid is present now;
# waiting a minute to decide whether they were authorised would miss them.
if conf_bool CAPTURE_PHOTO true; then
  if omarchy-emw-capture "$incident_dir/photo.jpg" >>"$incident_dir/capture.log" 2>&1; then
    log_journal "photo captured"
  else
    # A busy or missing camera degrades the evidence; it does not void the
    # incident, which is already on disk.
    log_journal "photo capture failed (see $incident_dir/capture.log)"
  fi
fi

# --- Grace period ----------------------------------------------------------
# This is the trusted-unlock mechanism, standing in for DoNotDisturb's Touch ID
# mode (Asahi has no fingerprint reader). The rule: if whoever opened the lid
# can unlock the session within the grace window, they are you.
grace=$(conf_get GRACE_SECONDS 60)
[[ $grace =~ ^[0-9]+$ ]] || grace=60

case $locked_at_trigger in
no-session)
  # Triggered with nobody logged in - a boot or a tty-only state. Nothing can
  # "unlock" to clear this, so it stands on its own as suspicious.
  verdict=unattended
  ;;
no)
  # The session was already unlocked, so the machine was open to anyone
  # walking past and a grace period cannot distinguish you from an intruder.
  # Default assumes an unlocked machine was one you were sitting at.
  if conf_bool ALERT_WHEN_UNLOCKED false; then
    verdict=intruder
  else
    verdict=attended
  fi
  ;;
*)
  # Reached for "yes" and for "unknown". Treating an undetermined lock state
  # as locked is deliberate: it costs a grace period and possibly a false
  # alert, whereas the other bias costs a missed intrusion.
  if conf_bool TRUSTED_UNLOCK true; then
    log_journal "locked; waiting up to ${grace}s for a trusted unlock"
    verdict=intruder
    deadline=$(($(date +%s) + grace))
    while (($(date +%s) < deadline)); do
      # tries=1: this loop is itself the retry, every 2s for the full window.
      if [[ $(emw_locked "$session_id" 1) == "no" ]]; then
        verdict=benign
        break
      fi
      sleep 2
    done
  else
    verdict=intruder
  fi
  ;;
esac

log_journal "verdict: $verdict"

# --- Record the verdict ----------------------------------------------------
photo_path=""
[[ -s $incident_dir/photo.jpg ]] && photo_path="$incident_dir/photo.jpg"

jq -n \
  --arg incident "$(basename "$incident_dir")" \
  --arg verdict "$verdict" \
  --arg locked "$locked_at_trigger" \
  --arg sources "$(tr '\n' ',' <"$incident_dir/sources" | sed 's/,$//')" \
  --arg photo "$photo_path" \
  --arg closed "$(date -Is)" \
  '{incident: $incident, verdict: $verdict, locked_at_trigger: $locked,
    sources: $sources, photo: $photo, closed: $closed}' \
  >"$incident_dir/verdict.json"

jq -n -c \
  --arg ts "$(date -Is)" \
  --arg incident "$(basename "$incident_dir")" \
  --arg verdict "$verdict" \
  --arg host "$(hostname)" \
  '{ts: $ts, incident: $incident, host: $host, event: "closed", verdict: $verdict}' \
  >>"$EVENTS_LOG"

# --- Notify ----------------------------------------------------------------
# A benign incident is deliberately quiet by default: if every lid open you
# make yourself produces a toast, you will stop reading them, and the one that
# matters will be the one you swipe away out of habit.
notify=false
case $verdict in
intruder | unattended) notify=true ;;
attended | benign) conf_bool NOTIFY_ON_BENIGN false && notify=true ;;
esac

# Passive mode records the incident and says nothing at all - no toast, no
# remote alert, no hooks. Upstream DoNotDisturb calls this passiveMode.
if conf_bool PASSIVE_MODE false; then
  log_journal "passive mode: incident logged, no alerting"
  notify=false
fi

if conf_bool DESKTOP_NOTIFY true && [[ $notify == "true" ]]; then
  sources_list=$(tr '\n' ',' <"$incident_dir/sources" | sed 's/,$//')
  case $verdict in
  intruder)
    headline="Lid opened while locked"
    body="Not unlocked within ${grace}s. Trigger: ${sources_list}."
    urgency=critical
    ;;
  unattended)
    headline="Physical access with no session"
    body="Trigger: ${sources_list}."
    urgency=critical
    ;;
  *)
    headline="Physical access recorded"
    body="Verdict: ${verdict}. Trigger: ${sources_list}."
    urgency=normal
    ;;
  esac

  notify_args=("$headline" "$body" --urgency "$urgency")
  [[ -n $photo_path ]] && notify_args+=(--image "$photo_path")
  omarchy-emw-notify "${notify_args[@]}" || log_journal "desktop notification failed"
fi

# --- Remote alert ----------------------------------------------------------
# The part that survives the machine being stolen or wiped. A failed send is
# spooled, not dropped: an evil-maid event is most likely precisely when the
# machine has no network.
alert=false
case $verdict in
intruder | unattended) alert=true ;;
attended) conf_bool ALERT_WHEN_UNLOCKED false && alert=true ;;
esac

if conf_bool PASSIVE_MODE false; then
  alert=false
fi

if [[ $alert == "true" ]]; then
  if omarchy-emw-alert "$incident_dir" --verdict "$verdict"; then
    log_journal "remote alert sent"
  else
    log_journal "remote alert failed; spooled for retry"
  fi
fi

log_journal "incident recorded at $incident_dir"

# Phases 5-6 attach here: resume/faillock/USB triggers and root hooks.
