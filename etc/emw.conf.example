# Omarchy EvilMaid Watch (EMW) configuration.
#
# Installed to /etc/omarchy/emw.conf as 0600 root:root - it holds API tokens.
#
# CONFIG_VERSION is the shape of this file, not the version of the software.
# It is bumped only when a change cannot be expressed by adding a key with a
# safe default - a renamed setting, a changed meaning, a removed feature.
# install.sh refuses to run against a config from a different version rather
# than migrating it: a security tool quietly inheriting settings across a
# breaking change is how a machine ends up armed differently than its owner
# believes. The supported path is uninstall.sh --purge-config, then install.
CONFIG_VERSION=1
# This file is sourced by bash, so values are shell syntax: quote anything
# with spaces, and do not add trailing comments on a value line.


# Master switch. Set false to stop reacting to triggers entirely.
ENABLED=true

# The desktop user to notify and whose lock state decides the verdict.
# Set automatically by install.sh; change it if you install for someone else.
EMW_USER=

# Which triggers are live. Comma-separated subset of:
#   lid       the lid switch opening
#   resume    waking from suspend or hibernate
#   faillock  failed unlock attempts at the lock screen
#   usb       a USB device being attached
#   wake      the machine being woken after going idle
#
# `wake` exists because a laptop left open does not suspend on idle here: it
# blanks and locks and stays awake, so nudging it produces no lid event and no
# resume. Whether a wake matters is decided by the lock state like any other
# trigger - waking your own unlocked machine is `attended` and silent.
TRIGGERS=lid,resume,faillock,usb,wake

# Log the incident locally but send nothing and run no hooks.
PASSIVE_MODE=false

# --- Trusted unlock -------------------------------------------------------
# Evidence is always captured immediately. Then we wait this long for someone
# to unlock the session. An unlock in time means it was you: the incident is
# logged as benign and no remote alert goes out. It stands in for a biometric
# unlock, since Asahi has no working fingerprint reader.
TRUSTED_UNLOCK=true
GRACE_SECONDS=20

# If the session was not locked when the trigger fired, a grace period cannot
# tell you from an intruder. Default assumes an unlocked machine was one you
# were actively using.
ALERT_WHEN_UNLOCKED=false

# How many failed unlock attempts within AUTH_FAILURE_WINDOW seconds count as
# one incident. Someone fat-fingering their own password once is not an
# intrusion; three misses in two minutes at a locked screen is a signal.
AUTH_FAILURE_THRESHOLD=3
AUTH_FAILURE_WINDOW=120

# --- Capture --------------------------------------------------------------
CAPTURE_PHOTO=true

# auto = pick the first /dev/video* that is a real capture device.
# Never hardcode /dev/video1: /dev/video0 on this machine is "avd", an Apple
# video decoder, and capturing from it will not produce a photo.
CAMERA_DEVICE=auto
PHOTO_RESOLUTION=1280x720

# Frames to discard before keeping one. The first frames are black until
# auto-exposure settles.
PHOTO_WARMUP_FRAMES=15

# NOTE: the camera LED is wired to camera power on Apple hardware and WILL
# light during capture. This is intended - it is the same deterrent behaviour
# as macOS. It cannot be disabled in software.

# --- Alerting -------------------------------------------------------------
# none | telegram | ntfy | both
ALERT_CHANNEL=none

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# How long a queued alert stays worth sending. A three-day-old "someone opened
# your laptop" is noise, and this also bounds the spool if it can never drain.
SPOOL_MAX_AGE_HOURS=72

# Desktop toast on the local session.
DESKTOP_NOTIFY=true

# Toast even when the incident turned out to be you (verdict benign/attended).
# Off by default on purpose: a toast for every lid open you make yourself
# trains you to dismiss them, and the one that matters is then the one you
# swipe away out of habit.
NOTIFY_ON_BENIGN=false

# --- Storage --------------------------------------------------------------
EVIDENCE_DIR=/var/lib/omarchy-emw

# How long evidence is kept, on two clocks. The photo is taken before the grace
# period can tell you from an intruder, so a benign incident still holds a
# picture of you - and keeping those as long as real evidence is a privacy cost
# with no forensic return.
#
# Note the one case this trades away: if someone knew or coerced your password
# and unlocked inside the grace window, the verdict is benign and that photo
# expires on the short clock.
#
# Either set to 0 to keep that class forever. events.log keeps the record of
# every incident permanently either way; only the photo and metadata expire.
RETAIN_DAYS=7
BENIGN_RETAIN_DAYS=2

# Collapse triggers that arrive within this window into one incident. Opening
# the lid after a suspend fires both the lid watcher and the resume unit, so
# this is required, not an optimisation.
DEBOUNCE_SECONDS=20

# --- Hooks ----------------------------------------------------------------
# Every executable here runs as root on an intruder verdict, with
# EMW_INCIDENT_DIR, EMW_SOURCE and EMW_VERDICT in the environment.
# Must be root-owned and not group/world-writable or it will be skipped:
# this directory runs code as root, so a user-writable hook would be a
# straight privilege escalation.
HOOK_DIR=/etc/omarchy/emw-hooks.d
HOOK_TIMEOUT=30
